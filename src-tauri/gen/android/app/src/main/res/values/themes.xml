<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Edge-to-edge: the web page draws under transparent system bars; the
         window colour shows until the first frame and matches the UI's page. -->
    <style name="Theme.private_music_desktop" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/pm_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
