{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Private Music",
  "version": "0.4.2",
  "identifier": "com.dec.privatemusic2.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; connect-src ipc: http://ipc.localhost; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Unofficial VK Music player",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "decoder-dev",
    "copyright": "Copyright © 2026 decoder-dev",
    "longDescription": "Private Music for the desktop: an unofficial VK Music player with a library, search, queue, synced lyrics and a live full-screen visualizer.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Private Music",
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 205
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 205
        }
      }
    },
    "linux": {
      "deb": {
        "section": "sound",
        "priority": "optional",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libasound2 | libasound2t64"
        ],
        "recommends": [
          "gnome-keyring | kwalletmanager",
          "libayatana-appindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
